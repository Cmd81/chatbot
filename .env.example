# ─────────────────────────────────────────────────────────────────────────────
#  این فایل را به .env کپی کنید و مقادیر را پر کنید.
#  ⚠️ فایل .env هرگز نباید داخل گیت برود (در .gitignore هست).
# ─────────────────────────────────────────────────────────────────────────────

# ── دامنه‌ها ────────────────────────────────────────────────────────────────
# رکورد A هر دو باید به آی‌پی همین سرور اشاره کند.
PUBLIC_HOST=chat.onlane.top
TURN_HOST=turn.onlane.top

# ایمیل برای Let's Encrypt (اخطار انقضای گواهی به این نشانی می‌آید)
ACME_EMAIL=admin@example.com

# ── ربات تلگرام ─────────────────────────────────────────────────────────────
# توکن را از @BotFather بگیرید. فقط همین‌جا نگهداری می‌شود.
TELEGRAM_BOT_TOKEN=

# polling (پیش‌فرض، ساده‌تر) | webhook | off
TELEGRAM_MODE=polling

# فقط برای TELEGRAM_MODE=webhook لازم است (رشته‌ی تصادفی، بدون / و فاصله)
TELEGRAM_WEBHOOK_SECRET=

# اگر به api.telegram.org دسترسی مستقیم ندارید، می‌توانید Bot API سرور
# شخصی یا پروکسی خود را اینجا بگذارید.
TELEGRAM_API_ROOT=https://api.telegram.org

# ── LiveKit ─────────────────────────────────────────────────────────────────
# با `./deploy.sh` به‌صورت خودکار ساخته می‌شوند.
# secret باید حداقل ۳۲ کاراکتر باشد.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── متفرقه ──────────────────────────────────────────────────────────────────
# ورود مهمان از سایت معمولی (بدون تلگرام)
ALLOW_GUEST=true
LOG_LEVEL=info
